<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05040C"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <View
        android:id="@+id/dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/movieShade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/movie_shade"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/movieInfo"
        android:layout_width="540dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="60dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/movieTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/inter_medium"
            android:maxLines="2"
            android:shadowColor="#AA000000"
            android:shadowRadius="10"
            android:textColor="#FFFFFFFF"
            android:textSize="36sp" />

        <TextView
            android:id="@+id/movieMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter_medium"
            android:shadowColor="#AA000000"
            android:shadowRadius="6"
            android:textColor="#EEFFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/movieOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter_regular"
            android:lineSpacingMultiplier="1.2"
            android:maxLines="3"
            android:shadowColor="#AA000000"
            android:shadowRadius="6"
            android:textColor="#DDFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="44dp"
        android:paddingTop="24dp"
        android:paddingEnd="36dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_light"
                    android:includeFontPadding="false"
                    android:shadowColor="#66000000"
                    android:shadowRadius="10"
                    android:textColor="#FFFFFFFF"
                    android:textSize="58sp" />

                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/inter_regular"
                    android:shadowColor="#66000000"
                    android:shadowRadius="6"
                    android:textColor="#DDFFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <com.glass.launcher.GlassFrame
                android:id="@+id/statusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="9dp">

                <LinearLayout
                    android:id="@+id/weatherBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/weatherIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/lc_cloud_sun" />
                    <TextView
                        android:id="@+id/weatherText"
                        style="@style/StatusText" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/netBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/netIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/lc_wifi" />
                    <TextView
                        android:id="@+id/ssidText"
                        style="@style/StatusText" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/vpnBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/vpnIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/lc_key_round" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/lc_bluetooth" />
                    <TextView
                        android:id="@+id/btCount"
                        style="@style/StatusText" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/notifBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/bellIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/lc_bell" />
                    <TextView
                        android:id="@+id/notifCount"
                        style="@style/StatusText" />
                </LinearLayout>

                <View
                    android:id="@+id/divider"
                    android:layout_width="1dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="18dp"
                    android:background="#59FFFFFF" />

                <LinearLayout
                    android:id="@+id/cpuBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/cpuIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/lc_cpu" />
                    <TextView
                        android:id="@+id/cpuText"
                        style="@style/StatusText" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ramBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ramIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/lc_memory_stick" />
                    <TextView
                        android:id="@+id/ramText"
                        style="@style/StatusText" />
                </LinearLayout>

                </LinearLayout>
            </com.glass.launcher.GlassFrame>


            <com.glass.launcher.GlassFrame
                android:id="@+id/profileBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="12dp"
                android:clickable="true"
                android:defaultFocusHighlightEnabled="false"
                android:focusable="true">

                <TextView
                    android:id="@+id/profileLetter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp" />
            </com.glass.launcher.GlassFrame>

            <com.glass.launcher.GlassFrame
                android:id="@+id/settingsBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:clickable="true"
                android:defaultFocusHighlightEnabled="false"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/lc_settings" />
            </com.glass.launcher.GlassFrame>

            <com.glass.launcher.GlassFrame
                android:id="@+id/powerBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:clickable="true"
                android:defaultFocusHighlightEnabled="false"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/lc_power" />
            </com.glass.launcher.GlassFrame>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/gridArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.glass.launcher.GlassFrame
                android:id="@+id/dock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/grid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
            </com.glass.launcher.GlassFrame>

            <TextView
                android:id="@+id/hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="140dp"
                android:layout_marginBottom="80dp"
                android:fontFamily="@font/inter_regular"
                android:textColor="#99FFFFFF"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <com.glass.launcher.GlassFrame
        android:id="@+id/updateBtn"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="84dp"
        android:layout_marginEnd="36dp"
        android:clickable="true"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/lc_download" />
            <TextView
                android:id="@+id/updateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/inter_medium"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </com.glass.launcher.GlassFrame>
</FrameLayout>
